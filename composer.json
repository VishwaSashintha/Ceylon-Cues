{
    "name": "ceylon-cues/backend",
    "description": "Ceylon Cues - Complete E-Commerce, ERP, Warehouse & Retail POS Backend System",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "CeylonCues\\": "src/",
            "CeylonCues\\Database\\": "database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CeylonCues\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "php database/migrate.php",
        "seed": "php database/seed.php",
        "app-install": "php database/install.php"
    },
    "config": {
        "sort-packages": true
    }
}
