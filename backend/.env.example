# Ceylon Cues Environment Configuration
# NEVER commit this file to version control
# Copy .env.example to .env and configure

# Application
APP_NAME="Ceylon Cues"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/ceylon-cues
APP_TIMEZONE=Asia/Colombo
APP_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ceylon_cues
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Session
SESSION_LIFETIME=120
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax

# File Uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_PATH=public/uploads

# Currency
CURRENCY_CODE=LKR
CURRENCY_SYMBOL=Rs.
CURRENCY_DECIMALS=2

# WhatsApp Business API
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_OWNER_NUMBER=
WHATSAPP_ENABLED=false

# Payment Gateways (Sandbox)
PAYMENT_GATEWAY_MODE=sandbox

# Email (future)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Ceylon Cues"

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_API_MAX=60
RATE_LIMIT_API_WINDOW=60

# Logging
LOG_LEVEL=debug
LOG_PATH=storage/logs

# Backup
BACKUP_PATH=storage/backups
BACKUP_RETENTION_DAYS=30
